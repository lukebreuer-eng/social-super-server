# ===========================================
# Social Engine - Environment Variables
# ===========================================

# Server
PORT=3001
NODE_ENV=production

# Directus
DIRECTUS_URL=https://social.ipaudio.nl
DIRECTUS_TOKEN=your_directus_static_token_here

# Redis (internal Coolify network)
REDIS_URL=redis://default:password@redis-hostname:6379

# MinIO (internal Coolify network)
MINIO_ENDPOINT=minio-hostname
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123secure
MINIO_BUCKET=social-super-server
MINIO_USE_SSL=false

# AI - Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Email - Resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@ipaudio.nl
NOTIFICATION_EMAIL=your_email@example.com

# Social Platforms (filled in after developer account approval)
# Meta (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.ipaudio.nl/oauth/meta/callback

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.ipaudio.nl/oauth/linkedin/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.ipaudio.nl/oauth/tiktok/callback

# API Security (leave empty to disable auth in development)
API_KEY=

# reCAPTCHA v3 — anti-spam op POST /api/leads. ZONDER secret weigert /api/leads alles
# (fail-closed). Sitekey staat in de WordPress mu-plugin ipvg-lead-token.php.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# Logging
LOG_LEVEL=info

# ===========================================
# Email AI Agent — IJs uit de Polder
# Alleen actief als IJS_EMAIL_AGENT_ENABLED=true
# ===========================================
IJS_EMAIL_AGENT_ENABLED=false
IJS_EMAIL_BEDRIJF_ID=7
IJS_INBOX_USER=info@ijsuitdepolder.nl
IJS_INBOX_PASSWORD=
IJS_IMAP_HOST=imap.transip.email
IJS_IMAP_PORT=993
IJS_IMAP_TLS=true
IJS_IMAP_INBOX_MAILBOX=INBOX
IJS_IMAP_SENT_MAILBOX=Sent
IJS_SMTP_HOST=smtp.transip.email
IJS_SMTP_PORT=587
IJS_SMTP_SECURE=false
IJS_FROM_NAME=IJs uit de Polder
# hybrid | always | never
IJS_REPLY_AUTO_SEND=hybrid
# categorieën die in hybrid-mode auto-verstuurd mogen worden
IJS_REPLY_AUTO_CATEGORIES=availability,info,pricing
IJS_POLL_LOOKBACK_HOURS=24
IJS_SIGNATURE=
